<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_catering_order" model="ir.actions.report">
        <field name="name">Catering Order</field>
        <field name="model">catering.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">leap_catering_management.report_catering_order_document</field>
        <field name="report_file">leap_catering_management.report_catering_order_document</field>
        <field name="binding_model_id" ref="model_catering_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Catering Order - %s' % (object.name)</field>
    </record>

    <template id="report_catering_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="o.name"/>
                        </h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Customer</strong>
                                <div t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'address']}"/>
                            </div>
                            <div class="col-6">
                                <strong>Event Date:</strong> <span t-field="o.event_date"/><br/>
                                <strong>Venue:</strong> <span t-field="o.venue"/><br/>
                                <strong>Guests:</strong> <span t-field="o.guest_count"/><br/>
                                <strong t-if="o.event_category_id">Event Type:</strong> <span t-field="o.event_category_id.name"/>
                            </div>
                        </div>

                        <table class="table table-sm o_main_table mt-4">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.package_line_ids" t-as="line">
                                    <td><span t-field="line.package_id.name"/></td>
                                    <td class="text-end"><span t-field="line.guest_count"/></td>
                                    <td class="text-end">
                                        <span t-field="line.unit_price" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                                <tr t-foreach="o.charge_line_ids" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end">
                                        <span t-field="line.unit_price" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row justify-content-end">
                            <div class="col-4">
                                <table class="table table-sm">
                                    <tr>
                                        <td>Packages</td>
                                        <td class="text-end">
                                            <span t-field="o.amount_packages" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Additional Charges</td>
                                        <td class="text-end">
                                            <span t-field="o.amount_charges" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr class="fw-bold border-top">
                                        <td>Total</td>
                                        <td class="text-end">
                                            <span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div t-if="o.notes" class="mt-4">
                            <strong>Terms &amp; Conditions</strong>
                            <p t-field="o.notes"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
