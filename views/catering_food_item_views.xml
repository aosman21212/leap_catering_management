<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_food_item_list" model="ir.ui.view">
        <field name="name">catering.food.item.list</field>
        <field name="model">catering.food.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="food_type_id"/>
            </list>
        </field>
    </record>

    <record id="view_catering_food_item_form" model="ir.ui.view">
        <field name="name">catering.food.item.form</field>
        <field name="model">catering.food.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Food item name"/></h1>
                    </div>
                    <group>
                        <field name="food_type_id"/>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_catering_food_item" model="ir.actions.act_window">
        <field name="name">Food Items</field>
        <field name="res_model">catering.food.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
