<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_checklist_template_list" model="ir.ui.view">
        <field name="name">catering.checklist.template.list</field>
        <field name="model">catering.checklist.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_catering_checklist_template_form" model="ir.ui.view">
        <field name="name">catering.checklist.template.form</field>
        <field name="model">catering.checklist.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Checklist name"/></h1>
                    </div>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_catering_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">catering.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
