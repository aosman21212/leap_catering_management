<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_order_tag_list" model="ir.ui.view">
        <field name="name">catering.order.tag.list</field>
        <field name="model">catering.order.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_catering_order_tag" model="ir.actions.act_window">
        <field name="name">Order Tags</field>
        <field name="res_model">catering.order.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
