<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_event_category_list" model="ir.ui.view">
        <field name="name">catering.event.category.list</field>
        <field name="model">catering.event.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_catering_event_category" model="ir.actions.act_window">
        <field name="name">Event Types</field>
        <field name="res_model">catering.event.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
