<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_food_photo_kanban" model="ir.ui.view">
        <field name="name">catering.food.photo.kanban</field>
        <field name="model">catering.food.photo</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image">
                            <img t-att-src="kanban_image('catering.food.photo', 'image', record.id.raw_value)" alt="Photo" class="o_kanban_image_fill_left"/>
                        </div>
                        <div class="oe_kanban_details">
                            <strong><field name="name"/></strong>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_catering_food_photo_list" model="ir.ui.view">
        <field name="name">catering.food.photo.list</field>
        <field name="model">catering.food.photo</field>
        <field name="arch" type="xml">
            <list>
                <field name="image" widget="image" options="{'size': [40, 40]}"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_catering_food_photo_form" model="ir.ui.view">
        <field name="name">catering.food.photo.form</field>
        <field name="model">catering.food.photo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Photo name"/></h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_catering_food_photo" model="ir.actions.act_window">
        <field name="name">Food Photo Gallery</field>
        <field name="res_model">catering.food.photo</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
