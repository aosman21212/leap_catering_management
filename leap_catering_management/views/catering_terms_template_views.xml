<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_terms_template_list" model="ir.ui.view">
        <field name="name">catering.terms.template.list</field>
        <field name="model">catering.terms.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_catering_terms_template_form" model="ir.ui.view">
        <field name="name">catering.terms.template.form</field>
        <field name="model">catering.terms.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template name"/></h1>
                    </div>
                    <field name="content" placeholder="Terms and conditions text..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_catering_terms_template" model="ir.actions.act_window">
        <field name="name">Terms &amp; Conditions Templates</field>
        <field name="res_model">catering.terms.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
