<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_service_charge_list" model="ir.ui.view">
        <field name="name">catering.service.charge.list</field>
        <field name="model">catering.service.charge</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="price"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_catering_service_charge_form" model="ir.ui.view">
        <field name="name">catering.service.charge.form</field>
        <field name="model">catering.service.charge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="price"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_catering_service_charge" model="ir.actions.act_window">
        <field name="name">Additional Items</field>
        <field name="res_model">catering.service.charge</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
