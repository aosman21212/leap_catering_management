<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_order_pivot" model="ir.ui.view">
        <field name="name">catering.order.pivot</field>
        <field name="model">catering.order</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="event_category_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="guest_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_catering_order_graph" model="ir.ui.view">
        <field name="name">catering.order.graph</field>
        <field name="model">catering.order</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="event_date" interval="month"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_catering_order_analysis" model="ir.actions.act_window">
        <field name="name">Order Analysis</field>
        <field name="res_model">catering.order</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_catering_order_search"/>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

    <record id="action_catering_invoice" model="ir.actions.act_window">
        <field name="name">Catering Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('invoice_origin', 'like', 'CATO')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>
</odoo>
