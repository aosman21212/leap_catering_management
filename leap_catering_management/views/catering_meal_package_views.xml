<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_meal_package_list" model="ir.ui.view">
        <field name="name">catering.meal.package.list</field>
        <field name="model">catering.meal.package</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="meal_type"/>
            </list>
        </field>
    </record>

    <record id="view_catering_meal_package_form" model="ir.ui.view">
        <field name="name">catering.meal.package.form</field>
        <field name="model">catering.meal.package</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_report_catering_meal_package)d" type="action" string="Print" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Package name"/></h1>
                    </div>
                    <group>
                        <field name="meal_type"/>
                    </group>
                    <field name="description" placeholder="Description..."/>
                    <notebook>
                        <page string="Food Items" name="food_items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="food_type_id"/>
                                    <field name="food_item_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Price per Head" name="price_tiers">
                            <field name="price_tier_ids">
                                <list editable="bottom">
                                    <field name="min_guests"/>
                                    <field name="max_guests"/>
                                    <field name="price_per_head"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Menu" name="menu">
                            <field name="menu_pdf" filename="menu_pdf_filename"/>
                            <field name="menu_pdf_filename" invisible="1"/>
                        </page>
                        <page string="Food Photos" name="photos">
                            <field name="photo_ids" widget="many2many">
                                <list>
                                    <field name="image" widget="image" options="{'size': [40, 40]}"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_catering_meal_package" model="ir.actions.act_window">
        <field name="name">Meal Packages</field>
        <field name="res_model">catering.meal.package</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
