<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_catering_order" name="Show Catering Orders" inherit_id="portal.portal_my_home" customize_show="True" priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Catering Orders</t>
                <t t-set="url" t-value="'/my/catering-orders'"/>
                <t t-set="count" t-value="catering_order_count"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_catering_orders" name="My Catering Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Catering Orders</t>
            </t>
            <t t-if="not orders">
                <p class="o_portal_my_doc_table">There are no catering orders.</p>
            </t>
            <t t-if="orders" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Reference</th>
                        <th>Event Date</th>
                        <th>Venue</th>
                        <th class="text-end">Guests</th>
                        <th class="text-end">Total</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="orders" t-as="order">
                        <td>
                            <a t-attf-href="/my/catering-orders/#{order.id}">
                                <t t-esc="order.name"/>
                            </a>
                        </td>
                        <td><span t-field="order.event_date"/></td>
                        <td><span t-field="order.venue"/></td>
                        <td class="text-end"><span t-field="order.guest_count"/></td>
                        <td class="text-end">
                            <span t-field="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                        </td>
                        <td><span t-field="order.state"/></td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_catering_order_page" name="Catering Order">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title" t-value="order.name"/>
            <div id="portal_order_content" class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2>
                        <span t-field="order.name"/>
                        <span class="badge text-bg-secondary ms-2" t-field="order.state"/>
                    </h2>
                    <a role="button" class="btn btn-secondary"
                       t-attf-href="/my/catering-orders/#{order.id}?report_type=pdf&amp;download=true">
                        <i class="fa fa-download me-1"/>Download PDF
                    </a>
                </div>

                <div class="row">
                    <div class="col-6">
                        <strong>Event Date:</strong> <span t-field="order.event_date"/><br/>
                        <strong>Venue:</strong> <span t-field="order.venue"/><br/>
                        <strong>Guests:</strong> <span t-field="order.guest_count"/>
                    </div>
                    <div class="col-6" t-if="order.event_category_id">
                        <strong>Event Type:</strong> <span t-field="order.event_category_id.name"/>
                    </div>
                </div>

                <table class="table table-sm mt-4">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="order.package_line_ids" t-as="line">
                            <td><span t-field="line.package_id.name"/></td>
                            <td class="text-end"><span t-field="line.guest_count"/></td>
                            <td class="text-end">
                                <span t-field="line.unit_price" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                            </td>
                        </tr>
                        <tr t-foreach="order.charge_line_ids" t-as="line">
                            <td><span t-field="line.name"/></td>
                            <td class="text-end"><span t-field="line.quantity"/></td>
                            <td class="text-end">
                                <span t-field="line.unit_price" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="row justify-content-end">
                    <div class="col-4">
                        <table class="table table-sm">
                            <tr class="fw-bold border-top">
                                <td>Total</td>
                                <td class="text-end">
                                    <span t-field="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div t-if="order.notes" class="mt-4">
                    <strong>Terms &amp; Conditions</strong>
                    <p t-field="order.notes"/>
                </div>

                <div t-if="order.state == 'done'" class="mt-4 card p-3">
                    <t t-if="order.rating_value">
                        <h4>Your Rating</h4>
                        <p>
                            Score: <strong><span t-esc="order.rating_value"/> / 5</strong>
                        </p>
                        <p t-if="order.rating_feedback" t-field="order.rating_feedback"/>
                    </t>
                    <t t-else="">
                        <h4>Rate Your Experience</h4>
                        <form t-attf-action="/my/catering-orders/#{order.id}/rate" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="access_token" t-att-value="access_token"/>
                            <div class="mb-2">
                                <select name="rating_value" class="form-select" style="max-width: 200px;" required="required">
                                    <option value="">Select a score</option>
                                    <option value="5">5 - Very Satisfied</option>
                                    <option value="4">4 - Satisfied</option>
                                    <option value="3">3 - Neutral</option>
                                    <option value="2">2 - Dissatisfied</option>
                                    <option value="1">1 - Very Dissatisfied</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <textarea name="rating_feedback" class="form-control" placeholder="Tell us about your experience (optional)"/>
                            </div>
                            <button type="submit" class="btn btn-primary">Submit Rating</button>
                        </form>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>
