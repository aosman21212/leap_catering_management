<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_product_list" model="ir.ui.view">
        <field name="name">catering.product.list</field>
        <field name="model">catering.product</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="price"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_catering_product_form" model="ir.ui.view">
        <field name="name">catering.product.form</field>
        <field name="model">catering.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Product name"/></h1>
                    </div>
                    <group>
                        <field name="price"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_catering_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">catering.product</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
