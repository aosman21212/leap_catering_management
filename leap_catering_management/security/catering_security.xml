<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_catering" model="ir.module.category">
        <field name="name">Catering</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_catering" model="res.groups.privilege">
        <field name="name">Catering</field>
        <field name="category_id" ref="module_category_catering"/>
    </record>

    <record id="group_catering_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_catering"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_catering_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_catering"/>
        <field name="implied_ids" eval="[(4, ref('group_catering_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>
</odoo>
