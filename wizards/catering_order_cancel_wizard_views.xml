<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catering_order_cancel_wizard_form" model="ir.ui.view">
        <field name="name">catering.order.cancel.wizard.form</field>
        <field name="model">catering.order.cancel.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>Only the selected orders that are still in <strong>Draft</strong> will be cancelled.</p>
                <group>
                    <field name="order_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="Reason for cancellation..."/>
                </group>
                <footer>
                    <button name="button_cancel" type="object" string="Cancel Orders" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_catering_order_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Cancel Selected Orders</field>
        <field name="res_model">catering.order.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_catering_order"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
